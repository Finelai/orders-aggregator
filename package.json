{
  "name": "orders-aggregator",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "lint": "biome lint src test vitest.config.ts",
    "format:check": "biome format src test vitest.config.ts",
    "format": "biome format --write src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
